OPENAI_API_KEY=sk-your-key-here
# Modelo opcional; si está vacío se conserva el predeterminado del SDK.
OPENAI_MODEL=
# PostgreSQL de HT5: puerto distinto al 5432 del Lab 4.
POSTGRES_PORT=5433
POSTGRES_DB=parachute_faqs
POSTGRES_USER=parachute
POSTGRES_PASSWORD=parachute_local
DATABASE_URL=postgresql://parachute:parachute_local@localhost:5433/parachute_faqs
FAQ_FILE=data/Corpus_FAQs_Parachute_SA_2026.txt
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
SEARCH_MIN_SIMILARITY=0.35
BOOKINGS_DB=data/bookings.sqlite3

# --- HT6: evals con Promptfoo -------------------------------------------
# API key de NVIDIA NIM (https://build.nvidia.com/settings/api-keys).
# La usan el agente evaluado y el grader de factuality.
NVIDIA_API_KEY=nvapi-your-key-here
# HT6 levanta PostgreSQL en 5434 (5433 puede estar ocupado). Si usas este
# puerto, ajusta también DATABASE_URL arriba:
# POSTGRES_PORT=5434
# DATABASE_URL=postgresql://parachute:parachute_local@localhost:5434/parachute_faqs
